# Copy these values into ~/.jobscout/.env using the local setup UI.
# Never commit a real .env or SMTP password to GitHub.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
# SMTP password is stored in the operating-system credential store via keyring.
REPORT_TO=your-email@example.com
REPORT_FROM=your-email@example.com
